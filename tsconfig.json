{
  "compilerOptions": {
    "target": "es5",
    "module": "commonjs",
    "outDir": "./dist",
    "lib": ["es2021"],
    "strict": true,
    "jsx": "react-native",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "declaration": true,
    "skipLibCheck": true,
    "typeRoots": [
      "./node_modules/@types",
      "./type-overrides"
    ],
    "paths": {
      "@daily-co/*": ["type-overrides/@daily-co/*"]
    }
  }
}
